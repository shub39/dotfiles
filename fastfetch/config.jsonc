{
  "display": {
    "color": {
      "keys": "#ebdbb2"
    },
    "key": {
      "width": 14
    },
    "separator": "  "
  },
  "logo": {
    "color": {
      "1": "#83a598"
    },
    "padding": {
      "left": 2,
      "top": 2
    },
    "type": "small"
  },
  "modules": [
    {
      "color": {
        "at": "#928374",
        "host": "#fabd2f",
        "user": "#fabd2f"
      },
      "type": "title"
    },
    "break",
    {
      "format": "{pretty-name}",
      "key": " os",
      "keyColor": "#83a598",
      "type": "os"
    },
    {
      "key": " kernel",
      "keyColor": "#d3869b",
      "type": "kernel"
    },
    {
      "format": "{pretty-name}",
      "key": " wm",
      "keyColor": "#fb4934",
      "type": "wm"
    },
    {
      "format": "{pretty-name}",
      "key": " shell",
      "keyColor": "#b8bb26",
      "type": "shell"
    },
    {
      "key": " uptime",
      "keyColor": "#d79921",
      "type": "uptime"
    },
    {
      "format": "{name}",
      "key": " cpu",
      "keyColor": "#8ec07c",
      "type": "cpu"
    },
    {
      "format": "",
      "key": " gpu",
      "keyColor": "#b16286",
      "type": "gpu"
    },
    {
      "format": "{used} / {total}",
      "key": " ram",
      "keyColor": "#83a598",
      "type": "memory"
    },
    {
      "format": "{name} {size}",
      "key": " font",
      "keyColor": "#fabd2f",
      "type": "terminalfont"
    },
    {
      "format": "{pretty-name}",
      "key": " color",
      "symbol": "circle",
      "type": "colors"
    }
  ]
}
